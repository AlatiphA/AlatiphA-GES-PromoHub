{
    "functions":  {
                      "source":  "functions"
                  },
    "firestore":  {
                      "rules":  "firestore.rules",
                      "indexes":  "firestore.indexes.json"
                  },
    "hosting":  {
                    "public":  "public",
                    "ignore":  [
                                   "firebase.json",
                                   ".firebaserc",
                                   "**/.*",
                                   "functions/**",
                                   "tests/**",
                                   "*.md",
                                   "package*.json",
                                   "**/*.ps1",
                                   "**/node_modules/**",
                                   "test-repair-backup-*/**",
                                   "sdk-backup-*/**",
                                   "**/*debug.log",
                                   "**/*.tmp",
                                   "baseline-correction-backup-*/**"
                               ],
                    "site":  "ges-promohub",
                    "headers":  [
                                    {
                                        "source":  "sw.js",
                                        "headers":  [
                                                        {
                                                            "key":  "Cache-Control",
                                                            "value":  "no-cache"
                                                        }
                                                    ]
                                    },
                                    {
                                        "source":  "version.json",
                                        "headers":  [
                                                        {
                                                            "key":  "Cache-Control",
                                                            "value":  "no-store"
                                                        }
                                                    ]
                                    }
                                ]
                },
    "emulators":  {
                      "firestore":  {
                                        "port":  8080
                                    },
                      "ui":  {
                                 "enabled":  false
                             },
                      "singleProjectMode":  true
                  }
}
